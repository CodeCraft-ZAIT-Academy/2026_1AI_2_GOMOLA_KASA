<Window x:Class="WpfAppmotokary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppmotokary"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnKukla" Content="Kukla   2€" HorizontalAlignment="Left" Margin="33,31,0,0" VerticalAlignment="Top" Height="96" Width="179" Background="#FF00E3FF" Click="btnKukla_Click"/>
        <Button x:Name="btnJazda" Content="Jazda    15€" HorizontalAlignment="Left" Margin="33,152,0,0" VerticalAlignment="Top" Height="96" Width="179" Background="#FF00E3FF" Click="btnJazda_Click"/>
        <Button x:Name="btnKofola" Content="Kofola   2€" HorizontalAlignment="Left" Margin="33,276,0,0" VerticalAlignment="Top" Height="91" Width="179" Background="#FF00E3FF" Click="btnKofola_Click"/>
        <Button x:Name="btnJedlo" Content="Jedlo   10€" HorizontalAlignment="Left" Margin="235,31,0,0" VerticalAlignment="Top" Height="96" Width="192" Background="#FF00E3FF" Click="btnJedlo_Click"/>
        <Button x:Name="btnMagnetka" Content="Magnetka   5€" HorizontalAlignment="Left" Margin="235,152,0,0" VerticalAlignment="Top" Height="96" Width="192" Background="#FF00E3FF" Click="btnMagnetka_Click"/>
        <Button x:Name="btnPrenajom" Content="1H Prenájom   120€" HorizontalAlignment="Left" Margin="235,276,0,0" VerticalAlignment="Top" Height="89" Width="192" Background="#FF00E3FF" Click="btnPrenajom_Click"/>
        <Button x:Name="btnNovyNakup" Content="Nový nákup" HorizontalAlignment="Left" Margin="508,359,0,0" VerticalAlignment="Top" Height="43" Width="186" Background="#FF00DAFF" Click="btnNovyNakup_Click"/>
        <TextBox x:Name="txtBlocik" HorizontalAlignment="Left" Margin="451,31,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="320" Height="246" Background="#FF7CA7AC"/>
        <Label x:Name="lblCena" Content="Celková cena:" HorizontalAlignment="Left" Margin="451,276,0,0" VerticalAlignment="Top" Height="72" Width="320" Background="White"/>

    </Grid>
</Window>
